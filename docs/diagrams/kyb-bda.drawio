graph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelBackgroundColor=default;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="48" height="48" as="geometry"/></mxCell><mxCell id="bda" value="Bedrock Data&lt;br&gt;Automation" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10.5;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;labelBackgroundColor=default;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="840" y="200" width="48" height="48" as="geometry"/></mxCell><mxCell id="out" value="S3: output&lt;br&gt;bucket" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10.5;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelBackgroundColor=default;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="48" height="48" as="geometry"/></mxCell><mxCell id="dlq" value="SQS: dead-&lt;br&gt;letter queue" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10.5;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;labelBackgroundColor=default;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="460" y="400" width="48" height="48" as="geometry"/></mxCell><mxCell id="bp" value="Custom KYB blueprint&lt;br&gt;(extraction schema)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontSize=10.5;fontStyle=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="790" y="300" width="150" height="40" as="geometry"/></mxCell><mxCell id="steps-t" value="&lt;b&gt;How it works&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="400" height="20" as="geometry"/></mxCell><mxCell id="steps-1-t" value="A business document (PDF, image or Word) is uploaded to the input bucket." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="76.0" y="573" width="1284.0" height="24" as="geometry"/></mxCell><mxCell id="steps-2-t" value="S3 publishes an Object Created event to EventBridge." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="76.0" y="605" width="1284.0" height="24" as="geometry"/></mxCell><mxCell id="steps-3-t" value="The EventBridge rule invokes the BDA processor Lambda (failed deliveries go to the SQS dead-letter queue)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="76.0" y="637" width="1284.0" height="24" as="geometry"/></mxCell><mxCell id="steps-4-t" value="The Lambda starts an asynchronous Bedrock Data Automation job with the custom KYB blueprint." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="76.0" y="669" width="1284.0" height="24" as="geometry"/></mxCell><mxCell id="steps-5-t" value="BDA writes the extracted KYB fields as JSON under processed/ in the output bucket." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="76.0" y="701" width="1284.0" height="24" as="geometry"/></mxCell><mxCell id="steps-6-t" value="The Lambda writes the job metadata under metadata/ for the audit trail." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="76.0" y="733" width="1284.0" height="24" as="geometry"/></mxCell><mxCell id="e1-step" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="118.0" y="195.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="e2-step" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="348.0" y="195.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="e3-step" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="518.0" y="195.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="e4-step" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="698.0" y="195.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="e5-step" value="5" s
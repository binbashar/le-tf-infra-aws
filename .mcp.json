{
  "mcpServers": {
    "aws-documentation": {
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "command": "uvx",
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws"
      },
      "type": "stdio"
    },
    "aws-mcp": {
      "args": [
        "mcp-proxy-for-aws-cli@1.8.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile",
        "bb-shared-devops",
        "--read-only",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "command": "uvx",
      "env": {
        "AWS_CONFIG_FILE": "${HOME}/.aws/bb/config",
        "AWS_SHARED_CREDENTIALS_FILE": "${HOME}/.aws/bb/credentials"
      },
      "type": "stdio"
    }
  }
}
